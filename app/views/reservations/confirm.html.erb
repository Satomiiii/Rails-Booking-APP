<h2 class="page-title">予約内容の確認</h2>

<%= form_with model: @reservation,
              url: room_reservations_path(@room),
              method: :post,
              scope: :reservation,
              local: true do |f| %>
  <%# create も params[:reservation] で受け取る %>

  <%= f.hidden_field :check_in %>
  <%= f.hidden_field :check_out %>
  <%= f.hidden_field :guests %>
  <%= f.hidden_field :room_id, value: @room.id %>

  <p>チェックイン： <%= @reservation.check_in_ymd %></p>
  <p>チェックアウト： <%= @reservation.check_out_ymd %></p>

  <p>日数： <%= @reservation.nights %>日</p>
  <p>人数： <%= @reservation.guests %>人</p>
  <p>お支払い金額： ¥<%= number_with_delimiter(@reservation.total_price) %></p>

  <%= f.submit '予約を確定', class: 'btn btn-primary' %>
  <%= link_to 'キャンセル', room_path(@room), class: 'btn btn-secondary' %>
<% end %>
