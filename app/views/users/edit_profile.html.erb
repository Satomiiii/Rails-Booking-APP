<div class="profile-settings">
  <h2>プロフィール</h2>

  <%= form_for(@user,
               url: update_profile_user_path(@user),
               method: :patch,
               html: { multipart: true }) do |f| %>

    <div>
      <%= f.label :icon, 'アイコン画像' %><br>
      <%= image_tag(@user.icon.attached? ? @user.icon : 'default-icon.png',
                    size: '80x80',
                    style: 'border-radius:50%;object-fit:cover;background:#eee;') %><br>
      <%= f.file_field :icon %>
    </div>

    <div>
      <%= f.label :name, '名前' %><br>
      <%= f.text_field :name, required: true %>
    </div>

    <div>
      <%= f.label :self_introduction, '自己紹介' %><br>
      <%= f.text_area :self_introduction, rows: 5 %>
    </div>

    <%= f.submit '保存', class: 'save-button' %>
    <%= link_to 'キャンセル', user_path(@user), class: 'cancel-button' %>
  <% end %>
</div>
