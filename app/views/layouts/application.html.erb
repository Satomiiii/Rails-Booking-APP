<!DOCTYPE html>
<html>
  <head>
    <title>Potepan Share</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all' %>
    <!-- JSはdeferを付けてヘッドに読み込む例 -->
    <%= javascript_pack_tag 'application', defer: true %>
  </head>

  <body>
    <header class="navbar">
      <%= link_to image_tag('logo.png'), root_path, class: 'logo' %>

      <!-- 認証機能導入前は固定リンクのみ -->
      <div class="auth-links">
        <%= link_to 'ログイン', '#', class: 'btn btn-login' %>
        <%= link_to '新規登録', '#', class: 'btn btn-signup' %>
      </div>
    </header>

    <%= yield %>
  </body>
</html>
