<!DOCTYPE html>
<html>
  <head>
    <title>Potepan Share</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header style="background:#243746;color:#fff;">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;">
        <%= link_to image_tag('logo.png', alt:'Potepan Share', style:'height:28px;'), root_path %>

        <% if user_signed_in? %>
          <!-- JS不要のドロップダウン（まずは open で必ず見えるように） -->
          <details class="user-menu" open style="position:relative;">
            <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:8px;">
              <%= image_tag(
                    current_user.icon.attached? ? url_for(current_user.icon) : 'default-icon.png',
                    style:'width:32px;height:32px;border-radius:50%;object-fit:cover;background:#eee;'
                  ) %>
              <span><%= (current_user.name.presence || current_user.email) %></span>
            </summary>

            <div class="user-dropdown"
                 style="position:absolute;right:0;top:120%;min-width:200px;background:#fff;color:#333;
                        border:1px solid #ddd;border-radius:8px;padding:8px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:1000;">
              <div><%= link_to '施設の新規登録', new_room_path %></div>
              <div><%= link_to '予約済み一覧',   reservations_path %></div>
              <div><%= link_to '登録済み施設',   rooms_path %></div>
              <div><%= link_to 'アカウント設定', account_user_path(current_user) %></div>
              <div>
                <%= button_to 'ログアウト', destroy_user_session_path,
                              method: :delete, form: { data: { turbo:false } },
                              style:'background:none;border:none;padding:0;margin:0;cursor:pointer;text-align:left;width:100%;' %>
              </div>
            </div>
          </details>
        <% else %>
          <div style="display:flex;gap:12px;">
            <%= link_to 'ログイン', new_user_session_path,  style:'color:#fff;text-decoration:underline;' %>
            <%= link_to '新規登録', new_user_registration_path, style:'color:#fff;text-decoration:underline;' %>
          </div>
        <% end %>
      </div>
    </header>

    <!-- フラッシュ -->
    <% if notice.present? %>
      <p style="margin:12px;color:#155724;background:#d4edda;padding:8px 12px;border-radius:6px;"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p style="margin:12px;color:#721c24;background:#f8d7da;padding:8px 12px;border-radius:6px;"><%= alert %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
